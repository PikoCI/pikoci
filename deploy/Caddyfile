{$PIKOCI_DOMAIN} {
	header Access-Control-Allow-Origin https://{$PIKOCI_WWW_DOMAIN}
	header Access-Control-Allow-Methods "GET, OPTIONS"
	header Access-Control-Allow-Headers "Content-Type, Authorization"
	# Both HTTP API and gRPC worker streaming are multiplexed on port 8080 via cmux.
	# Caddy handles HTTP/2 (including gRPC) automatically.
	reverse_proxy host.docker.internal:8080
}

{$PIKOCI_GRAFANA_DOMAIN} {
	reverse_proxy grafana:3000
}

{$PIKOCI_WWW_DOMAIN} {
	root * /var/www/pikoci.com
	file_server
	encode gzip
}

{$PIKOCI_DOCS_DOMAIN} {
	root * /var/www/docs.pikoci.com
	file_server
	encode gzip
}

www.{$PIKOCI_WWW_DOMAIN} {
	redir https://{$PIKOCI_WWW_DOMAIN}{uri} permanent
}
